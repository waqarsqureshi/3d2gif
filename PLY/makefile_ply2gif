OPENCV_PKG := $(shell if pkg-config --exists opencv4; then echo opencv4; elif pkg-config --exists opencv; then echo opencv; fi)

ifeq ($(OPENCV_PKG),)
$(error Neither opencv4 nor opencv pkg-config package were found. Install OpenCV development packages and verify pkg-config can locate OpenCV)
endif

gifPLY: ply2gif.cpp
	g++ -Wall -g ply2gif.cpp -o gifPLY -std=c++11 -I /home/xyz/vcglib/vcglib -I ../libs/sm_lib/ `pkg-config $(OPENCV_PKG) --cflags --libs` -lGL -lGLU -lglut
